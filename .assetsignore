# Cloudflare Workers Assets ignore list (gitignore syntax).
# These files are part of the repo but NOT part of the public website.

# VCS / config / secrets
.git
.gitignore
.assetsignore
.wrangler
.claude
node_modules
.env
.env.*
.dev.vars
.dev.vars.*
.DS_Store

# Build tooling
package.json
package-lock.json
scripts

# Internal docs / templates (not published pages)
AGENTS.md
blog/README.md
blog/article-template.html
BUSINESS_DESCRIPTIONS.md
GMB_SETUP.md
DISTRIBUTION.md

# Camera originals (2-6 MB each), kept in the repo only as sources for the
# optimized img/*-1200.jpeg copies. Never referenced by a published page.
img/IMG_*.JPG.jpeg
img/WhatsApp Image *.jpeg

# Design scratch page for the Google Business cover photo, not a public page
gmb-cover-photo.html
